# Copy to .env and edit. .env is git-ignored; never commit real paths to
# private data or any credential.

# Directory that holds the raw datasets (defaults to the repository root).
LSTM_FIN_DATA_DIR=/path/to/your/data

# Where plots, saved models and run summaries are written.
LSTM_FIN_ARTIFACTS_DIR=./artifacts

# File names inside LSTM_FIN_DATA_DIR - override if yours differ.
LSTM_FIN_STOCK_FILE=World-Stock-Prices-Dataset.csv
LSTM_FIN_ECONOMIC_FILE=economic-indicators_Data.csv
LSTM_FIN_ECONOMIC_METADATA_FILE=economic-indicators_Series - Metadata.csv
LSTM_FIN_RBI_FILE=RBIB Table No. 01 _ Select Economic Indicators.xlsx

# Global random seed for reproducible runs.
LSTM_FIN_SEED=42

# Set to 1 to use an interactive matplotlib backend instead of writing PNGs.
# LSTM_FIN_INTERACTIVE_PLOTS=1

# Only needed if you download the stock dataset with the Kaggle CLI.
# KAGGLE_USERNAME=your-kaggle-username
# KAGGLE_KEY=your-kaggle-api-token
